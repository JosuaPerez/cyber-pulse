# Imagen de revisión aislada. No tiene entrypoint del bot ni necesita .env.
FROM python:3.14-slim-bookworm@sha256:48b13b003dda20b16f9442b8475aa05fe21bf6579a8c881db92ffb4d8fd20f83
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /bot
COPY requirements.txt /tmp/bot-requirements.txt
COPY app/reels/requirements.txt /tmp/reel-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/bot-requirements.txt \
    && python -m pip install --no-cache-dir -r /tmp/reel-requirements.txt \
    && playwright install --with-deps chromium \
    && apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system cyberpulse && useradd --system --gid cyberpulse --create-home cyberpulse \
    && mkdir -p /bot/media && chown -R cyberpulse:cyberpulse /bot
COPY --chown=cyberpulse:cyberpulse . .
USER cyberpulse
ENTRYPOINT ["python", "-m", "app.reels.myth"]
CMD ["--compare", "--render"]
