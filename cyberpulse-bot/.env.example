# Copia este archivo a .env y completa cada valor con tus propias credenciales.
# NUNCA subas el archivo .env real a git — está excluido en .gitignore.

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Meta Graph API (Instagram) ---
META_ACCESS_TOKEN=
IG_USER_ID=
META_GRAPH_VERSION=v23.0

# --- Cloudflare R2 (almacenamiento de imágenes) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Control de publicación ---
# true: genera todo el contenido pero NO publica nada (deja media/post_pendiente.txt para revisión)
DRY_RUN=true
# true: además de Instagram, publica un hilo en X (requiere plan de pago de la API de X)
PUBLICAR_EN_X=false

# --- X / Twitter (solo si PUBLICAR_EN_X=true) ---
CONSUMER_KEY_X=
CONSUMER_SECRET_X=
ACCESS_TOKEN_X=
ACCESS_TOKEN_SECRET_X=

# --- Frontend / Playwright ---
TEMPLATES_BASE_URL=http://plantillas-vite:5173

# --- Rutas persistentes ---
DATA_DIR=data
MEDIA_DIR=media

# --- Timeouts y reintentos ---
HTTP_TIMEOUT=15
RSS_MAX_BYTES=2000000
ARTICULO_MAX_BYTES=5000000
HTTP_MAX_REDIRECCIONES=3
META_POLL_INTERVAL=3
META_POLL_TIMEOUT=90
INTERVALO_CICLO_SEGUNDOS=900
MAX_INTENTOS_PUBLICACION=3
REINTENTO_BASE_SEGUNDOS=300
# Tiempo máximo durante el que otro worker no puede reclamar la misma noticia.
RESERVA_PUBLICACION_SEGUNDOS=1800
